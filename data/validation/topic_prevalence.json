    "PA": {
      "topic": "Privileged access",
      "pattern": "\\b(privileged (?:access|accounts?|users?|operations?)|administrative (?:access|accounts?|privileges?)|administrator accounts?|least privilege|elevated privilege|domain admin)\\b"
