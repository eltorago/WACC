+NOISE_SUFFIXES = (".pyc", ".pyo", ".log", ".tmp", ".swp", ".patch")
+
+# Transport, by name. The patch manifest is regenerated whenever patches are, so tracking
+# it means every series ends with a commit describing the series before it. It travels
+# with the patches instead, which is where a later session looks for it.
+TRANSPORT = ("MANIFEST.json",)
 
 
 @dataclass
@@ -97,7 +104,7 @@ def would_ship(root: str) -> List[str]:
             subdirectories[:] = []
             continue
         for name in files:
-            if name.endswith(NOISE_SUFFIXES):
+            if name.endswith(NOISE_SUFFIXES) or name in TRANSPORT:
                 continue
             if name.lower().endswith(SOURCE_SUFFIXES):
                 continue
@@ -189,6 +196,7 @@ def gitignore() -> str:
     lines = [GITIGNORE_HEADER, "# Noise"]
     lines.extend(sorted("%s/" % name for name in NOISE if name != ".git"))
     lines.extend(sorted("*%s" % suffix for suffix in NOISE_SUFFIXES))
+    lines.extend(sorted(TRANSPORT))
 
     lines.append("")
     lines.append("# Excluded in full, whatever they hold")
